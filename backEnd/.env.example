# Copia este archivo como .env y completa TUS datos (el .env nunca se sube a git)
# La clave va entre comillas simples porque puede contener # o $
DJANGO_SECRET_KEY=''
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Oracle FreeSQL (datos del panel de freesql.com)
ORACLE_HOST=db.freesql.com
ORACLE_PORT=2484
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
# FreeSQL exige TLS (tcps) en el puerto 2484. Vacío = automático según el puerto
ORACLE_PROTOCOL=

# Origen del frontend React + Vite
FRONTEND_ORIGIN=http://localhost:5173

# En producción con HTTPS cambiar a True
COOKIE_SECURE=False
